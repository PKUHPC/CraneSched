[Unit]
Description=Crane
After=network.target nss-lookup.target

[Service]
User=root
Group=root
# Extra command line options for craned, e.g. CRANED_OPTIONS="-F gpu".
EnvironmentFile=-/etc/sysconfig/craned
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/craned $CRANED_OPTIONS
LimitMEMLOCK=infinity
LimitSTACK=infinity

[Install]
WantedBy=multi-user.target
